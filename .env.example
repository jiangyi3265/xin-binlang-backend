HOST=127.0.0.1
PORT=8897
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xin_binlang
DB_PASSWORD=
DB_NAME=xin_binlang
DB_CONNECTION_LIMIT=12
DB_SSL=false
DB_AUTO_CREATE=false
DB_SEED=false
TOKEN_SECRET=
PUBLIC_ORIGIN=http://127.0.0.1:8897
ALLOWED_ORIGINS=http://127.0.0.1:8897
# 生产必须指向 releases 之外的共享目录：systemd 用 ProtectSystem=strict 把
# /opt/xin-binlang/current 挂成只读，只有 ReadWritePaths 里的 shared/uploads 可写；
# 而且 current 每次发布都指向新的 release 目录，写在里面的图片会随发布丢失。
# 本地开发用 ./uploads；生产设置为 /opt/xin-binlang/shared/uploads。
UPLOAD_DIR=./uploads
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_WIN=
WECHAT_TEMPLATE_VERIFY=
WECHAT_TEMPLATE_EXPIRING=

# 路径相对于本 backend 仓库，也可以填写绝对路径。
ADMIN_DIR=../总部管理后台
H5_DIR=../槟榔小程序端/dist/build/h5

# 仅开发库显式启用 DB_SEED=true 时填写，各至少 16 位随机字符。
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_SALES_PASSWORD=
SEED_STORE_PASSWORD=
# 密码轮换 --only-weak 可用；填写需检测的旧口令 JSON 数组，留空不启用。
LEGACY_PASSWORDS_JSON=
